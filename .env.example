# Copie para .env.local. Os valores locais aparecem em `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key do supabase status>
SUPABASE_SERVICE_ROLE_KEY=<service_role key do supabase status>
# Conexão direta ao Postgres local, usada só pelos testes para limpar o banco.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# URL pública da aplicação, usada no link de recuperação de senha.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
